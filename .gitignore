# ==============================================================================
# Environment variables and secrets (NEVER COMMIT)
# ==============================================================================
.env
.env.*
!.env.example
*.env

# ==============================================================================
# Python bytecode & cache
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==============================================================================
# Virtual Environments
# ==============================================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# Databases (Local SQLite & dumps)
# ==============================================================================
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
db.sqlite3
*.db
*.sql

# ==============================================================================
# Django Media & Collected Static Files
# ==============================================================================
# Keep media directory structure via .gitkeep but ignore uploaded media
media/*
!media/.gitkeep

# Collected static files for production (generated by collectstatic)
staticfiles/

# Logs
*.log

# ==============================================================================
# Editors & OS Files
# ==============================================================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Temporary files & root test artifacts
*.tmp
*.bak
*.swp
/*.jpg
/*.png
/*.jpeg
